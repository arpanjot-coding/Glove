{
  "name": "glove",
  "productName": "Glove",
  "version": "0.1.0",
  "description": "A Windows workspace for Android and iPhone",
  "author": "Glove contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.mjs",
  "scripts": {
    "dev": "node scripts/develop.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "mcp": "node src/mcp/main.mjs",
    "test": "node --test test/*.test.mjs",
    "package:win": "node scripts/brand.mjs && npm run build && node scripts/package.mjs",
    "installer:win": "npm run package:win && node scripts/installer.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@fluentui/react-icons": "2.0.345",
    "node-forge": "1.4.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.7"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
